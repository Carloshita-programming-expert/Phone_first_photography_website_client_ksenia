---
import { client } from '../../tina/__generated__/client';
import { Mail, ArrowUp, Sparkles } from 'lucide-astro';

interface Props {
  currentLang?: 'en' | 'ru';
}

const { currentLang = 'en' } = Astro.props;

const defaultProfile = {
  name: 'Ksenia',
  email: 'ksenia@visualstories.photography',
};

// Fetch Global Profile singleton data from TinaCMS
let profileNode: any = null;
try {
  if (typeof client.queries.global_profile === 'function') {
    const res = await client.queries.global_profile({ relativePath: 'ksenia.json' });
    profileNode = res?.data?.global_profile;
  } else if (typeof client.queries.global_profileConnection === 'function') {
    const res = await client.queries.global_profileConnection();
    profileNode = res?.data?.global_profileConnection?.edges?.[0]?.node;
  } else if (typeof (client.queries as any).profile === 'function') {
    const res = await (client.queries as any).profile({ relativePath: 'ksenia.json' });
    profileNode = res?.data?.profile;
  } else if (typeof (client.queries as any).profileConnection === 'function') {
    const res = await (client.queries as any).profileConnection();
    profileNode = res?.data?.profileConnection?.edges?.[0]?.node;
  }
} catch (_err) {
  // Graceful fallback
}

const profile = profileNode || defaultProfile;

const name = profile?.name || defaultProfile.name;
const email = profile?.email || defaultProfile.email;
const currentYear = new Date().getFullYear();
---

<footer
  class="global-footer w-full border-t border-luxury-taupe/20 bg-luxury-base/95 backdrop-blur-md pt-12 pb-24 lg:pb-12 px-6 text-center select-none lg:snap-start"
  aria-label="Universal Site Footer"
>
  <div class="max-w-2xl mx-auto flex flex-col items-center">
    <!-- Subtle Editorial Brand Monogram -->
    <div class="flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-luxury-crimson animate-pulse"></span>
      <span class="font-serif tracking-widest text-xs uppercase font-medium text-luxury-taupe">
        {name} · Analog Visual Archives
      </span>
    </div>

    <!-- Editorial Call to Action Heading -->
    <h3 class="font-serif text-2xl sm:text-3xl text-luxury-cream tracking-tight font-normal">
      <span data-bio-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>
        Available for Commissions & Worldwide Inquiries
      </span>
      <span data-bio-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>
        Открыта для коммерческих съемок и международных проектов
      </span>
    </h3>

    <!-- Subtitle Description -->
    <p class="text-xs sm:text-sm text-luxury-taupe max-w-md mx-auto mt-2 font-light leading-relaxed">
      <span data-bio-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>
        Editorial assignments, architecture documentation, analog prints, and artistic collaborations.
      </span>
      <span data-bio-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>
        Редакционные съемки, архитектурная документалистика, авторские отпечатки и арт-коллаборации.
      </span>
    </p>

    <!-- Primary Contact / Booking Button (Linked to TinaCMS Email) -->
    <div class="mt-6 flex flex-col items-center">
      <a
        href={`mailto:${email}?subject=Commission%20%2F%20Booking%20Inquiry`}
        class="inline-flex items-center gap-2.5 px-8 py-3 rounded-full bg-luxury-cream text-luxury-base border border-luxury-taupe font-semibold text-xs uppercase tracking-widest hover:bg-luxury-crimson hover:text-luxury-cream hover:border-luxury-crimson hover:scale-105 active:scale-95 transition-all shadow-[0_0_30px_rgba(113,28,29,0.25)]"
        aria-label={`Send booking inquiry to ${email}`}
      >
        <Mail class="w-4 h-4 stroke-[2]" />
        <span data-bio-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>
          Contact & Booking
        </span>
        <span data-bio-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>
          Связаться и забронировать
        </span>
      </a>

      <!-- Direct Email Label -->
      <a
        href={`mailto:${email}`}
        class="mt-3 text-xs font-mono text-luxury-taupe hover:text-luxury-cream transition-colors"
      >
        {email}
      </a>
    </div>

    <!-- Divider -->
    <div class="w-16 h-[1px] bg-luxury-taupe/20 my-8"></div>

    <!-- Footer Bottom: Copyright & Back to Top -->
    <div class="w-full flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-mono text-luxury-taupe">
      <div class="text-center sm:text-left">
        <span data-bio-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>
          © {currentYear} {name}. All rights reserved. Curated 35mm works.
        </span>
        <span data-bio-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>
          © {currentYear} {name}. Все права защищены. Архив пленочных работ.
        </span>
      </div>

      <button
        type="button"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="inline-flex items-center gap-1.5 text-luxury-taupe hover:text-luxury-cream transition-colors uppercase tracking-wider"
        aria-label="Scroll back to top"
      >
        <span>Top</span>
        <ArrowUp class="w-3 h-3 stroke-[2]" />
      </button>
    </div>
  </div>
</footer>

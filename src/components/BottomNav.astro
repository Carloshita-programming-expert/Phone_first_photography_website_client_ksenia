---
import { Home, Layers, Grid, User } from 'lucide-astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  currentLang?: 'en' | 'ru';
  activeTab?: 'home' | 'portfolio' | 'grid' | 'about';
}

const { currentLang = 'en', activeTab } = Astro.props;

const tEn = useTranslations('en');
const tRu = useTranslations('ru');

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedActiveTab: 'home' | 'portfolio' | 'grid' | 'about' =
  activeTab ||
  (pathname.startsWith('/portfolio')
    ? 'portfolio'
    : pathname.startsWith('/collage')
      ? 'grid'
      : pathname.startsWith('/profile')
        ? 'about'
        : 'home');
---

<nav
  class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[470px] z-50 bg-luxury-base/95 backdrop-blur-xl border-t border-luxury-taupe/20 px-6 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom,0px))] transition-all duration-300 lg:hidden"
  aria-label="Mobile Bottom Navigation"
>
  <div class="flex items-center justify-between">
    <!-- Home Tab -->
    <a
      href="/"
      id="nav-home"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'home'
          ? 'text-luxury-cream font-medium'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-label="Home Feed"
      aria-current={resolvedActiveTab === 'home' ? 'page' : undefined}
    >
      <Home class={`w-5 h-5 stroke-[1.8] ${resolvedActiveTab === 'home' ? 'text-luxury-cream' : 'text-luxury-taupe'}`} />
      <span class="text-[10px] tracking-tight">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.feed')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.feed')}</span>
      </span>
      {resolvedActiveTab === 'home' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-luxury-crimson shadow-[0_0_8px_rgba(113,28,29,0.9)]"></span>
      )}
    </a>

    <!-- Portfolio Decks Tab -->
    <a
      href="/portfolio"
      id="nav-portfolio"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'portfolio'
          ? 'text-luxury-cream font-medium'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-label="Portfolio Decks"
      aria-current={resolvedActiveTab === 'portfolio' ? 'page' : undefined}
    >
      <Layers class={`w-5 h-5 stroke-[1.8] ${resolvedActiveTab === 'portfolio' ? 'text-luxury-cream' : 'text-luxury-taupe'}`} />
      <span class="text-[10px] tracking-tight">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.portfolio')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.portfolio')}</span>
      </span>
      {resolvedActiveTab === 'portfolio' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-luxury-crimson shadow-[0_0_8px_rgba(113,28,29,0.9)]"></span>
      )}
    </a>

    <!-- Grid / Collage Tab -->
    <a
      href="/collage"
      id="nav-grid"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'grid'
          ? 'text-luxury-cream font-medium'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-label="Collage Grid"
      aria-current={resolvedActiveTab === 'grid' ? 'page' : undefined}
    >
      <Grid class={`w-5 h-5 stroke-[1.8] ${resolvedActiveTab === 'grid' ? 'text-luxury-cream' : 'text-luxury-taupe'}`} />
      <span class="text-[10px] tracking-tight">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.collage')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.collage')}</span>
      </span>
      {resolvedActiveTab === 'grid' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-luxury-crimson shadow-[0_0_8px_rgba(113,28,29,0.9)]"></span>
      )}
    </a>

    <!-- Profile / About Tab -->
    <a
      href="/profile"
      id="nav-about"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'about'
          ? 'text-luxury-cream font-medium'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-label="Photographer Profile"
      aria-current={resolvedActiveTab === 'about' ? 'page' : undefined}
    >
      <User class={`w-5 h-5 stroke-[1.8] ${resolvedActiveTab === 'about' ? 'text-luxury-cream' : 'text-luxury-taupe'}`} />
      <span class="text-[10px] tracking-tight">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.profile')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.profile')}</span>
      </span>
      {resolvedActiveTab === 'about' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-luxury-crimson shadow-[0_0_8px_rgba(113,28,29,0.9)]"></span>
      )}
    </a>

    <!-- Language Toggle (EN / RU) -->
    <div
      class="flex items-center bg-luxury-base border border-luxury-taupe/30 rounded-full p-0.5 text-[11px] font-semibold text-luxury-taupe"
      role="group"
      aria-label="Language Selector"
    >
      <button
        type="button"
        data-lang-btn="en"
        class={`lang-toggle-btn px-2.5 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'en'
            ? 'bg-luxury-crimson text-luxury-cream shadow-sm font-semibold'
            : 'text-luxury-taupe hover:text-luxury-cream'
        }`}
        aria-pressed={currentLang === 'en' ? 'true' : 'false'}
      >
        EN
      </button>
      <button
        type="button"
        data-lang-btn="ru"
        class={`lang-toggle-btn px-2.5 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'ru'
            ? 'bg-luxury-crimson text-luxury-cream shadow-sm font-semibold'
            : 'text-luxury-taupe hover:text-luxury-cream'
        }`}
        aria-pressed={currentLang === 'ru' ? 'true' : 'false'}
      >
        RU
      </button>
    </div>
  </div>
</nav>

<script>
  function setupLanguageToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
    const url = new URL(window.location.href);
    let storedLang: string | null = null;
    try {
      storedLang = localStorage.getItem('ksenia_lang');
    } catch (_e) {}
    const initialLang = (url.searchParams.get('lang') as 'en' | 'ru') || (storedLang as 'en' | 'ru') || 'en';

    function setLanguage(lang: 'en' | 'ru') {
      try {
        localStorage.setItem('ksenia_lang', lang);
      } catch (_e) {}

      document.documentElement.lang = lang;
      document.documentElement.setAttribute('data-current-lang', lang);

      // Handle FOUC guard style tag
      const foucGuard = document.getElementById('ksenia-i18n-fouc-guard');
      if (lang === 'ru') {
        if (!foucGuard) {
          const style = document.createElement('style');
          style.id = 'ksenia-i18n-fouc-guard';
          style.textContent =
            '[data-i18n-lang="en"], [data-title-lang="en"], [data-caption-lang="en"], [data-bio-lang="en"] { display: none !important; }' +
            '[data-i18n-lang="ru"], [data-title-lang="ru"], [data-caption-lang="ru"], [data-bio-lang="ru"] { display: revert !important; }';
          document.head.appendChild(style);
        }
      } else {
        if (foucGuard) {
          foucGuard.remove();
        }
      }

      buttons.forEach((btn) => {
        const btnLang = btn.getAttribute('data-lang-btn');
        const isActive = btnLang === lang;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) {
          btn.classList.add('bg-luxury-crimson', 'text-luxury-cream', 'shadow-sm', 'font-semibold');
          btn.classList.remove('text-luxury-taupe', 'hover:text-luxury-cream', 'bg-neutral-100', 'text-black', 'text-neutral-400', 'hover:text-white');
        } else {
          btn.classList.remove('bg-luxury-crimson', 'text-luxury-cream', 'shadow-sm', 'font-semibold', 'bg-neutral-100', 'text-black');
          btn.classList.add('text-luxury-taupe', 'hover:text-luxury-cream');
        }
      });

      // Synchronize all UI elements with data-i18n-lang
      document.querySelectorAll<HTMLElement>('[data-i18n-lang]').forEach((el) => {
        const i18nLang = el.getAttribute('data-i18n-lang');
        if (i18nLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Synchronize FeedPost & Filmstrip titles
      document.querySelectorAll<HTMLElement>('[data-title-lang]').forEach((el) => {
        const titleLang = el.getAttribute('data-title-lang');
        if (titleLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Synchronize FeedPost captions
      document.querySelectorAll<HTMLElement>('[data-caption-lang]').forEach((el) => {
        const captionLang = el.getAttribute('data-caption-lang');
        if (captionLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Synchronize Profile bio paragraphs
      document.querySelectorAll<HTMLElement>('[data-bio-lang]').forEach((el) => {
        const bioLang = el.getAttribute('data-bio-lang');
        if (bioLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('lang', lang);
      window.history.replaceState({}, '', newUrl.toString());
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedLang = btn.getAttribute('data-lang-btn') as 'en' | 'ru';
        if (selectedLang) {
          setLanguage(selectedLang);
        }
      });
    });

    setLanguage(initialLang);
  }

  setupLanguageToggle();
  document.addEventListener('astro:page-load', setupLanguageToggle);
</script>

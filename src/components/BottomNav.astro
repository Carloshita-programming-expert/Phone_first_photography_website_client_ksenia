---
import { Home, Grid, User } from 'lucide-astro';

interface Props {
  currentLang?: 'en' | 'ru';
  activeTab?: 'home' | 'grid' | 'about';
}

const { currentLang = 'en', activeTab } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedActiveTab: 'home' | 'grid' | 'about' =
  activeTab ||
  (pathname.startsWith('/collage')
    ? 'grid'
    : pathname.startsWith('/profile')
      ? 'about'
      : 'home');
---

<nav
  class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[470px] z-50 bg-neutral-950/90 backdrop-blur-xl border-t border-neutral-800/80 px-6 py-2.5 transition-all duration-300 lg:hidden"
  aria-label="Mobile Bottom Navigation"
>
  <div class="flex items-center justify-between">
    <!-- Home Tab -->
    <a
      href="/"
      id="nav-home"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'home'
          ? 'text-white font-medium'
          : 'text-neutral-400 hover:text-neutral-200'
      }`}
      aria-label="Home Feed"
      aria-current={resolvedActiveTab === 'home' ? 'page' : undefined}
    >
      <Home class="w-5 h-5 stroke-[1.8]" />
      <span class="text-[10px] tracking-tight">Feed</span>
      {resolvedActiveTab === 'home' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-white shadow-[0_0_6px_rgba(255,255,255,0.8)]"></span>
      )}
    </a>

    <!-- Grid / Collage Tab -->
    <a
      href="/collage"
      id="nav-grid"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'grid'
          ? 'text-white font-medium'
          : 'text-neutral-400 hover:text-neutral-200'
      }`}
      aria-label="Collage Grid"
      aria-current={resolvedActiveTab === 'grid' ? 'page' : undefined}
    >
      <Grid class="w-5 h-5 stroke-[1.8]" />
      <span class="text-[10px] tracking-tight">Collage</span>
      {resolvedActiveTab === 'grid' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-white shadow-[0_0_6px_rgba(255,255,255,0.8)]"></span>
      )}
    </a>

    <!-- Profile / About Tab -->
    <a
      href="/profile"
      id="nav-about"
      class={`relative flex flex-col items-center gap-1 py-1 transition-colors ${
        resolvedActiveTab === 'about'
          ? 'text-white font-medium'
          : 'text-neutral-400 hover:text-neutral-200'
      }`}
      aria-label="Photographer Profile"
      aria-current={resolvedActiveTab === 'about' ? 'page' : undefined}
    >
      <User class="w-5 h-5 stroke-[1.8]" />
      <span class="text-[10px] tracking-tight">Profile</span>
      {resolvedActiveTab === 'about' && (
        <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-white shadow-[0_0_6px_rgba(255,255,255,0.8)]"></span>
      )}
    </a>

    <!-- Language Toggle (EN / RU) -->
    <div
      class="flex items-center bg-neutral-900 border border-neutral-800 rounded-full p-0.5 text-[11px] font-semibold text-neutral-400"
      role="group"
      aria-label="Language Selector"
    >
      <button
        type="button"
        data-lang-btn="en"
        class={`lang-toggle-btn px-2.5 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'en'
            ? 'bg-neutral-100 text-black shadow-sm font-semibold'
            : 'text-neutral-400 hover:text-white'
        }`}
        aria-pressed={currentLang === 'en' ? 'true' : 'false'}
      >
        EN
      </button>
      <button
        type="button"
        data-lang-btn="ru"
        class={`lang-toggle-btn px-2.5 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'ru'
            ? 'bg-neutral-100 text-black shadow-sm font-semibold'
            : 'text-neutral-400 hover:text-white'
        }`}
        aria-pressed={currentLang === 'ru' ? 'true' : 'false'}
      >
        RU
      </button>
    </div>
  </div>
</nav>

<script>
  function setupLanguageToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
    const url = new URL(window.location.href);
    const initialLang = (url.searchParams.get('lang') as 'en' | 'ru') || 'en';

    function setLanguage(lang: 'en' | 'ru') {
      buttons.forEach((btn) => {
        const btnLang = btn.getAttribute('data-lang-btn');
        const isActive = btnLang === lang;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) {
          btn.classList.add('bg-neutral-100', 'text-black', 'shadow-sm', 'font-semibold');
          btn.classList.remove('text-neutral-400', 'hover:text-white');
        } else {
          btn.classList.remove('bg-neutral-100', 'text-black', 'shadow-sm', 'font-semibold');
          btn.classList.add('text-neutral-400', 'hover:text-white');
        }
      });

      // Synchronize FeedPost & Filmstrip titles
      document.querySelectorAll<HTMLElement>('[data-title-lang]').forEach((el) => {
        const titleLang = el.getAttribute('data-title-lang');
        if (titleLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Synchronize FeedPost captions
      document.querySelectorAll<HTMLElement>('[data-caption-lang]').forEach((el) => {
        const captionLang = el.getAttribute('data-caption-lang');
        if (captionLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Synchronize Profile bio paragraphs
      document.querySelectorAll<HTMLElement>('[data-bio-lang]').forEach((el) => {
        const bioLang = el.getAttribute('data-bio-lang');
        if (bioLang === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('lang', lang);
      window.history.replaceState({}, '', newUrl.toString());
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedLang = btn.getAttribute('data-lang-btn') as 'en' | 'ru';
        if (selectedLang) {
          setLanguage(selectedLang);
        }
      });
    });

    setLanguage(initialLang);
  }

  setupLanguageToggle();
  document.addEventListener('astro:page-load', setupLanguageToggle);
</script>

---
import { getCloudinaryUrl } from '../utils/cloudinary';
import { Camera, MapPin } from 'lucide-astro';

export interface PostItem {
  id?: string;
  title?: string;
  location?: string;
  camera?: string;
  date?: string;
  images?: (string | null)[] | null;
  caption_en?: string | null;
  caption_ru?: string | null;
  _sys?: { filename?: string };
}

interface Props {
  posts: PostItem[];
}

const { posts = [] } = Astro.props;

// Flatten all images into a unified collection of curated photographs with metadata
const allPhotos = posts.flatMap((post) => {
  const images = (post.images || []).filter(Boolean) as string[];
  return images.map((imgId, idx) => ({
    id: `${post.id || post._sys?.filename || 'shoot'}-${idx}`,
    imgId,
    title: post.title || 'Untitled Series',
    location: post.location || 'Unknown Location',
    camera: post.camera || '35mm Film',
    date: post.date || '',
    index: idx + 1,
    total: images.length,
    postSlug: post.id || post._sys?.filename,
  }));
});
---

<div class="w-full">
  <div class="columns-2 sm:columns-3 lg:columns-4 gap-3 sm:gap-4 space-y-3 sm:space-y-4">
    {allPhotos.map((photo, i) => (
      <figure
        class="break-inside-avoid relative group rounded-sm overflow-hidden bg-neutral-950 border border-neutral-900 shadow-sm transition-all duration-300 hover:border-neutral-700 hover:shadow-xl"
      >
        <div class="w-full relative overflow-hidden bg-neutral-900/40">
          <img
            src={getCloudinaryUrl(photo.imgId, 'f_auto,q_auto')}
            alt={`${photo.title} · ${photo.location}`}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full h-auto block object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3 pointer-events-none">
            <span class="text-xs font-semibold text-white tracking-tight leading-tight drop-shadow-sm">
              {photo.title}
            </span>
            <div class="flex items-center gap-1 text-[10px] text-neutral-300 mt-1">
              <MapPin class="w-3 h-3 text-neutral-400 stroke-[2]" />
              <span>{photo.location}</span>
            </div>
            <div class="flex items-center justify-between text-[9px] font-mono text-neutral-400 mt-1 border-t border-white/10 pt-1">
              <span>{photo.camera}</span>
              <span>{photo.index}/{photo.total}</span>
            </div>
          </div>
        </div>
      </figure>
    ))}
  </div>
</div>

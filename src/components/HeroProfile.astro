---
import { client } from '../../tina/__generated__/client';
import { getCloudinaryUrl } from '../utils/cloudinary';
import { Mail, Camera, MapPin, Sparkles, ChevronDown } from 'lucide-astro';

interface Props {
  currentLang?: 'en' | 'ru';
}

const { currentLang = 'en' } = Astro.props;

// Fetch singleton Global Profile data from TinaCMS
const profileRes = await (client.queries.global_profileConnection
  ? client.queries.global_profileConnection()
  : client.queries.profileConnection());

const profileNode =
  profileRes.data?.global_profileConnection?.edges?.[0]?.node ||
  profileRes.data?.profileConnection?.edges?.[0]?.node ||
  profileRes.data?.global_profile ||
  profileRes.data?.profile;

const name = profileNode?.name || 'Ksenia';
const bioEn =
  profileNode?.bio_en ||
  'Visual artist and analog photographer based in Berlin. Exploring brutalist geometry, fleeting nocturnal light, and solitary landscapes across Europe and Central Asia using 35mm and medium format film.';
const bioRu =
  profileNode?.bio_ru ||
  'Визуальный художник и пленочный фотограф из Берлина. Исследует геометрию брутализма, ускользающий ночной свет и уединенные пейзажи Европы и Центральной Азии на 35-миллиметровую и среднеформатную пленку.';
const email = profileNode?.email || 'ksenia@visualstories.photography';
const portrait = profileNode?.portrait || profileNode?.profile_image || 'samples/people/smiling-man';
---

<section
  class="hero-profile min-h-screen w-full flex flex-col justify-between items-center text-center px-4 py-8 sm:py-12 lg:py-16 relative"
  aria-label="Photographer Profile"
>
  <!-- Spacer for top balance -->
  <div></div>

  <!-- Central Editorial Profile Content -->
  <div class="w-full max-w-xl mx-auto flex flex-col items-center">
    <!-- Editorial Profile Portrait with Ambient Glow -->
    <div class="relative group mb-6">
      <div
        class="absolute -inset-1.5 rounded-full bg-gradient-to-tr from-neutral-700 via-neutral-800 to-neutral-600 opacity-60 blur-md group-hover:opacity-100 transition duration-700"
      ></div>
      <div
        class="relative w-32 h-32 sm:w-40 sm:h-40 lg:w-44 lg:h-44 rounded-full overflow-hidden border-2 border-neutral-800 shadow-2xl bg-neutral-900"
      >
        <img
          src={getCloudinaryUrl(portrait, 'f_auto,q_auto')}
          alt={`${name} portrait`}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        />
      </div>
      <!-- Available indicator -->
      <div
        class="absolute bottom-1 right-2 w-6 h-6 rounded-full bg-emerald-500/90 border-2 border-black flex items-center justify-center shadow-lg"
        title="Available for commissions"
      >
        <Sparkles class="w-3 h-3 text-black stroke-[2.5]" />
      </div>
    </div>

    <!-- Editorial Identity -->
    <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-neutral-100 font-normal tracking-tight">
      {name}
    </h1>
    <div class="flex items-center gap-2 mt-2 text-xs font-mono uppercase tracking-widest text-neutral-400">
      <span class="flex items-center gap-1">
        <MapPin class="w-3 h-3 text-neutral-500" />
        Berlin · Worldwide
      </span>
      <span>•</span>
      <span class="flex items-center gap-1">
        <Camera class="w-3 h-3 text-neutral-500" />
        Analog Works
      </span>
    </div>

    <!-- Editorial Divider -->
    <div class="w-12 h-[1px] bg-neutral-800 my-5 sm:my-6"></div>

    <!-- Dynamic Bilingual Bio Text -->
    <div class="w-full space-y-3 text-sm sm:text-base leading-relaxed text-neutral-300 font-light text-center px-2">
      <!-- English Bio Block -->
      <p
        class={`bio-text-en transition-opacity duration-200 ${currentLang === 'ru' ? 'hidden' : ''}`}
        data-bio-lang="en"
      >
        {bioEn}
      </p>

      <!-- Russian Bio Block -->
      <p
        class={`bio-text-ru text-neutral-300 italic text-sm sm:text-base transition-opacity duration-200 ${currentLang === 'en' ? 'hidden' : ''}`}
        data-bio-lang="ru"
      >
        {bioRu}
      </p>
    </div>

    <!-- Contact Button -->
    <div class="mt-7">
      <a
        href={`mailto:${email}?subject=Commission%20%2F%20Print%20Inquiry`}
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-neutral-100 text-black font-semibold text-xs uppercase tracking-widest hover:bg-white hover:scale-105 active:scale-95 transition-all shadow-[0_0_20px_rgba(255,255,255,0.15)]"
      >
        <Mail class="w-3.5 h-3.5 text-black stroke-[2]" />
        <span>Initiate Inquiry</span>
      </a>
    </div>
  </div>

  <!-- Bottom Scroll Cue: Prompt to view curated photography below -->
  <div class="w-full flex flex-col items-center pt-8 pb-4 text-neutral-500">
    <a
      href="#photography-section"
      class="flex flex-col items-center gap-2 group cursor-pointer transition-colors hover:text-neutral-300"
      aria-label="Scroll down to photography"
    >
      <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-neutral-400 group-hover:text-neutral-200 transition-colors">
        Curated Photography
      </span>
      <ChevronDown class="w-4 h-4 text-neutral-400 group-hover:text-white transition-transform duration-300 group-hover:translate-y-1 animate-bounce" />
    </a>
  </div>
</section>

---
import { useTranslations } from '../i18n/ui';

interface Props {
  currentLang?: 'en' | 'ru';
  activeTab?: 'home' | 'portfolio' | 'grid' | 'about';
}

const { currentLang = 'en', activeTab } = Astro.props;

const tEn = useTranslations('en');
const tRu = useTranslations('ru');

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedActiveTab: 'home' | 'portfolio' | 'grid' | 'about' =
  activeTab ||
  (pathname.startsWith('/portfolio')
    ? 'portfolio'
    : pathname.startsWith('/collage')
      ? 'grid'
      : pathname.startsWith('/profile')
        ? 'about'
        : 'home');
---

<header
  class="hidden lg:flex sticky top-0 z-50 w-full bg-luxury-base/90 backdrop-blur-xl border-b border-luxury-taupe/20 px-8 py-4 items-center justify-between transition-all"
  aria-label="Desktop Top Navigation"
>
  <!-- Studio Brand -->
  <a href="/" class="flex items-center gap-3 group">
    <span class="font-serif text-lg tracking-wider font-medium text-luxury-cream group-hover:text-luxury-taupe transition-colors uppercase">
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('brand.name')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('brand.name')}</span>
    </span>
    <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-luxury-taupe border-l border-luxury-taupe/30 pl-3">
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('brand.tagline')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('brand.tagline')}</span>
    </span>
    <span class="w-1.5 h-1.5 rounded-full bg-luxury-crimson animate-pulse"></span>
  </a>

  <!-- Navigation Links -->
  <nav class="flex items-center gap-8 text-xs font-mono uppercase tracking-[0.2em]" aria-label="Desktop Links">
    <a
      href="/"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'home'
          ? 'text-luxury-cream font-semibold'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-current={resolvedActiveTab === 'home' ? 'page' : undefined}
    >
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.feed')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.feed')}</span>
      {resolvedActiveTab === 'home' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-luxury-crimson rounded-full"></span>
      )}
    </a>

    <a
      href="/portfolio"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'portfolio'
          ? 'text-luxury-cream font-semibold'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-current={resolvedActiveTab === 'portfolio' ? 'page' : undefined}
    >
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.portfolio')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.portfolio')}</span>
      {resolvedActiveTab === 'portfolio' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-luxury-crimson rounded-full"></span>
      )}
    </a>

    <a
      href="/collage"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'grid'
          ? 'text-luxury-cream font-semibold'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-current={resolvedActiveTab === 'grid' ? 'page' : undefined}
    >
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.collage')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.collage')}</span>
      {resolvedActiveTab === 'grid' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-luxury-crimson rounded-full"></span>
      )}
    </a>

    <a
      href="/profile"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'about'
          ? 'text-luxury-cream font-semibold'
          : 'text-luxury-taupe hover:text-luxury-cream'
      }`}
      aria-current={resolvedActiveTab === 'about' ? 'page' : undefined}
    >
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.profile')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.profile')}</span>
      {resolvedActiveTab === 'about' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-luxury-crimson rounded-full"></span>
      )}
    </a>
  </nav>

  <!-- Desktop Controls: Admin Link & Language Toggle -->
  <div class="flex items-center gap-4">
    <a
      href="/admin/index.html"
      class="text-[10px] font-mono uppercase tracking-widest text-luxury-taupe hover:text-luxury-cream border border-luxury-taupe/40 rounded px-2.5 py-1 hover:border-luxury-taupe hover:bg-luxury-crimson transition-all"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('nav.cmsAdmin')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('nav.cmsAdmin')}</span>
    </a>

    <!-- Desktop Language Switcher -->
    <div
      class="flex items-center bg-luxury-base border border-luxury-taupe/30 rounded-full p-0.5 text-xs font-semibold text-luxury-taupe"
      role="group"
      aria-label="Desktop Language Selector"
    >
      <button
        type="button"
        data-lang-btn="en"
        class={`lang-toggle-btn px-3 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'en'
            ? 'bg-luxury-crimson text-luxury-cream shadow-sm font-semibold'
            : 'text-luxury-taupe hover:text-luxury-cream'
        }`}
        aria-pressed={currentLang === 'en' ? 'true' : 'false'}
      >
        EN
      </button>
      <button
        type="button"
        data-lang-btn="ru"
        class={`lang-toggle-btn px-3 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'ru'
            ? 'bg-luxury-crimson text-luxury-cream shadow-sm font-semibold'
            : 'text-luxury-taupe hover:text-luxury-cream'
        }`}
        aria-pressed={currentLang === 'ru' ? 'true' : 'false'}
      >
        RU
      </button>
    </div>
  </div>
</header>

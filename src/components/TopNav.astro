---
interface Props {
  currentLang?: 'en' | 'ru';
  activeTab?: 'home' | 'grid' | 'about';
}

const { currentLang = 'en', activeTab } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolvedActiveTab: 'home' | 'grid' | 'about' =
  activeTab ||
  (pathname.startsWith('/collage')
    ? 'grid'
    : pathname.startsWith('/profile')
      ? 'about'
      : 'home');
---

<header
  class="hidden lg:flex sticky top-0 z-50 w-full bg-black/80 backdrop-blur-xl border-b border-neutral-900/80 px-8 py-4 items-center justify-between transition-all"
  aria-label="Desktop Top Navigation"
>
  <!-- Studio Brand -->
  <a href="/" class="flex items-center gap-3 group">
    <span class="font-serif text-lg tracking-wider font-medium text-neutral-100 group-hover:text-white transition-colors">
      KSENIA
    </span>
    <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-neutral-400 border-l border-neutral-800 pl-3">
      Visual Stories
    </span>
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
  </a>

  <!-- Navigation Links -->
  <nav class="flex items-center gap-8 text-xs font-mono uppercase tracking-[0.2em]" aria-label="Desktop Links">
    <a
      href="/"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'home'
          ? 'text-white font-semibold'
          : 'text-neutral-400 hover:text-neutral-100'
      }`}
      aria-current={resolvedActiveTab === 'home' ? 'page' : undefined}
    >
      Feed
      {resolvedActiveTab === 'home' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-white rounded-full"></span>
      )}
    </a>

    <a
      href="/collage"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'grid'
          ? 'text-white font-semibold'
          : 'text-neutral-400 hover:text-neutral-100'
      }`}
      aria-current={resolvedActiveTab === 'grid' ? 'page' : undefined}
    >
      Collage
      {resolvedActiveTab === 'grid' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-white rounded-full"></span>
      )}
    </a>

    <a
      href="/profile"
      class={`transition-colors py-1 relative ${
        resolvedActiveTab === 'about'
          ? 'text-white font-semibold'
          : 'text-neutral-400 hover:text-neutral-100'
      }`}
      aria-current={resolvedActiveTab === 'about' ? 'page' : undefined}
    >
      Profile
      {resolvedActiveTab === 'about' && (
        <span class="absolute -bottom-1 left-0 w-full h-[2px] bg-white rounded-full"></span>
      )}
    </a>
  </nav>

  <!-- Desktop Controls: Admin Link & Language Toggle -->
  <div class="flex items-center gap-4">
    <a
      href="/admin/index.html"
      class="text-[10px] font-mono uppercase tracking-widest text-neutral-400 hover:text-neutral-200 border border-neutral-800 rounded px-2.5 py-1 hover:border-neutral-700 transition-colors"
      target="_blank"
      rel="noopener noreferrer"
    >
      CMS Admin
    </a>

    <!-- Desktop Language Switcher -->
    <div
      class="flex items-center bg-neutral-900 border border-neutral-800 rounded-full p-0.5 text-xs font-semibold text-neutral-400"
      role="group"
      aria-label="Desktop Language Selector"
    >
      <button
        type="button"
        data-lang-btn="en"
        class={`lang-toggle-btn px-3 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'en'
            ? 'bg-neutral-100 text-black shadow-sm font-semibold'
            : 'text-neutral-400 hover:text-white'
        }`}
        aria-pressed={currentLang === 'en' ? 'true' : 'false'}
      >
        EN
      </button>
      <button
        type="button"
        data-lang-btn="ru"
        class={`lang-toggle-btn px-3 py-1 rounded-full transition-all duration-200 ${
          currentLang === 'ru'
            ? 'bg-neutral-100 text-black shadow-sm font-semibold'
            : 'text-neutral-400 hover:text-white'
        }`}
        aria-pressed={currentLang === 'ru' ? 'true' : 'false'}
      >
        RU
      </button>
    </div>
  </div>
</header>

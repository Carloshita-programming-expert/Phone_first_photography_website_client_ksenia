---
import { getCloudinaryUrl } from '../utils/cloudinary';
import { Camera, MapPin, Film, Calendar } from 'lucide-astro';
import { useTranslations } from '../i18n/ui';

export interface PostItem {
  id?: string;
  title?: string;
  title_ru?: string;
  location?: string;
  camera?: string;
  date?: string;
  images?: (string | null)[] | null;
  caption_en?: string | null;
  caption_ru?: string | null;
  _sys?: { filename?: string };
}

interface Props {
  posts: PostItem[];
  currentLang?: 'en' | 'ru';
}

const { posts = [], currentLang = 'en' } = Astro.props;

const tEn = useTranslations('en');
const tRu = useTranslations('ru');

// Flatten all images into a sequenced filmstrip series
const filmstripFrames = posts.flatMap((post, postIdx) => {
  const images = (post.images || []).filter(Boolean) as string[];
  return images.map((imgId, imgIdx) => ({
    frameId: `${post.id || postIdx}-${imgIdx}`,
    imgId,
    titleEn: post.title || 'Untitled Series',
    titleRu: post.title_ru || post.title || 'Безымянная серия',
    location: post.location || 'Unknown Location',
    camera: post.camera || '35mm Film',
    date: post.date || 'Recent',
    captionEn: post.caption_en || '',
    captionRu: post.caption_ru || '',
    frameNumber: String(imgIdx + 1).padStart(2, '0'),
    totalFrames: String(images.length).padStart(2, '0'),
    seriesTitleEn: post.title || 'Series',
    seriesTitleRu: post.title_ru || post.title || 'Серия',
  }));
});
---

<div class="w-full relative py-6 select-none" aria-label="Desktop Filmstrip Gallery">
  <!-- Filmstrip Aesthetic Perforations (Top Border) -->
  <div class="w-full border-t border-b border-luxury-taupe/20 bg-luxury-base/60 py-2.5 px-6 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-luxury-taupe">
    <div class="flex items-center gap-3">
      <span class="flex items-center gap-1.5 text-luxury-taupe">
        <Film class="w-3.5 h-3.5 text-luxury-taupe" />
        <span>
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.stripBadge')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.stripBadge')}</span>
        </span>
      </span>
      <span class="text-luxury-taupe/40">|</span>
      <span>
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.isoBadge')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.isoBadge')}</span>
      </span>
    </div>
    <div class="flex items-center gap-3 text-luxury-taupe">
      <span>
        {filmstripFrames.length}{' '}
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.curatedExposures')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.curatedExposures')}</span>
      </span>
      <span class="text-luxury-taupe/40">|</span>
      <span class="text-luxury-taupe">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.dragWheelHint')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.dragWheelHint')}</span>
      </span>
    </div>
  </div>

  <!-- Main Horizontal Scroll Container -->
  <div
    class="desktop-horizontal-gallery flex flex-row overflow-x-auto gap-6 sm:gap-8 px-8 py-8 items-stretch no-scrollbar scroll-smooth focus:outline-none cursor-grab select-none overscroll-x-contain"
    style="overscroll-behavior-x: contain;"
    tabindex="0"
    role="region"
    aria-label="Horizontal Photography Filmstrip"
  >
    {filmstripFrames.map((frame, idx) => (
      <article
        class="flex-shrink-0 flex flex-col justify-between bg-luxury-base/90 border border-luxury-taupe/20 rounded-md p-3 group transition-all duration-300 hover:border-luxury-taupe/60 hover:shadow-[0_10px_35px_rgba(11,12,14,0.9)]"
        data-film-frame={idx}
      >
        <!-- Top Frame Metadata Header -->
        <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-luxury-taupe pb-2.5 border-b border-luxury-taupe/20 mb-3">
          <div class="flex items-center gap-2">
            <span class="text-luxury-cream font-semibold">{currentLang === 'ru' ? tRu('filmstrip.exp') : tEn('filmstrip.exp')} {String(idx + 1).padStart(2, '0')}</span>
            <span class="text-luxury-taupe/40">·</span>
            <span class="text-luxury-taupe">{frame.camera}</span>
          </div>
          <span class="text-luxury-taupe">{frame.frameNumber}/{frame.totalFrames}</span>
        </div>

        <!-- Film Frame Image Area (h-[70vh] w-auto) -->
        <div class="relative h-[68vh] xl:h-[70vh] w-auto overflow-hidden rounded bg-luxury-base flex items-center justify-center border border-luxury-taupe/10">
          <img
            src={getCloudinaryUrl(frame.imgId, 'f_auto,q_auto')}
            alt={`${frame.titleEn} · ${frame.location}`}
            loading={idx < 4 ? 'eager' : 'lazy'}
            decoding="async"
            class="h-full w-auto max-w-none object-contain select-none pointer-events-none transition-transform duration-700 ease-out group-hover:scale-[1.015]"
          />

          <!-- Ambient Bottom Vignette Gradient on Hover -->
          <div class="absolute inset-0 bg-gradient-to-t from-luxury-base/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
        </div>

        <!-- Bottom Frame Metadata & Bilingual Title -->
        <div class="pt-3 border-t border-luxury-taupe/20 mt-3 flex flex-col gap-1">
          <div class="flex items-center justify-between">
            <!-- Dynamic Bilingual Title -->
            <h3
              class="font-serif text-sm tracking-tight text-luxury-cream font-medium"
              data-title-container
            >
              <span
                class={`title-text-en ${currentLang === 'ru' ? 'hidden' : ''}`}
                data-title-lang="en"
              >
                {frame.titleEn}
              </span>
              <span
                class={`title-text-ru ${currentLang === 'en' ? 'hidden' : ''}`}
                data-title-lang="ru"
              >
                {frame.titleRu}
              </span>
            </h3>

            <!-- Location Badge -->
            <div class="flex items-center gap-1 text-[11px] font-mono text-luxury-taupe">
              <MapPin class="w-3 h-3 text-luxury-taupe" />
              <span>{frame.location}</span>
            </div>
          </div>

          <!-- Date & Caption Snippet -->
          <div class="flex items-center justify-between text-[10px] font-mono text-luxury-taupe mt-0.5">
            <span class="flex items-center gap-1">
              <Calendar class="w-3 h-3 text-luxury-taupe" />
              <span>{frame.date}</span>
            </span>
            <span class="text-[9px] tracking-widest uppercase text-luxury-taupe/70">
              Negative ID #{frame.frameId}
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Filmstrip Aesthetic Perforations (Bottom Border) -->
  <div class="w-full border-t border-b border-luxury-taupe/20 bg-luxury-base/60 py-2 px-6 flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.3em] text-luxury-taupe/80">
    <div class="flex items-center gap-4">
      <span>▲ SAFETY FILM ▲</span>
      <span>EASTMAN 5222</span>
      <span>FRAME SAFETY MARGIN</span>
    </div>
    <div class="flex items-center gap-4 text-luxury-taupe">
      <span>END OF CASSETTE</span>
    </div>
  </div>
</div>

<script>
  interface GalleryInstance {
    destroy: () => void;
  }

  // Active instances registry for unmount / Astro view transitions cleanup
  const activeGalleries: GalleryInstance[] = [];

  function cleanupActiveGalleries() {
    while (activeGalleries.length > 0) {
      const instance = activeGalleries.pop();
      if (instance) {
        instance.destroy();
      }
    }
  }

  function setupDesktopHorizontalGallery() {
    cleanupActiveGalleries();

    const galleries = document.querySelectorAll<HTMLElement>('.desktop-horizontal-gallery');

    galleries.forEach((gallery) => {
      let isDown = false;
      let startX = 0;
      let lastX = 0;
      let lastTime = 0;
      let velocity = 0;
      let rafId: number | null = null;
      let hasDragged = false;
      let intervalId: number | null = null;
      let idleTimer: number | null = null;
      let isHovered = false;
      let isTouchInteracting = false;
      let touchResetTimeout: number | null = null;

      // Stop any pending inertia loop
      const cancelInertia = () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      };

      // 1. Smart Auto-Centering Ticker (5-second interval, geometric alignment)
      const executeSmartAutoCentering = () => {
        // Halt if user is interacting: hovering, dragging, touch, or active momentum inertia
        if (isDown || isHovered || isTouchInteracting || rafId !== null || Math.abs(velocity) > 0.05) {
          return;
        }

        const cards = Array.from(gallery.querySelectorAll<HTMLElement>('[data-film-frame]'));
        if (cards.length === 0) return;

        // Container horizontal center point in scroll coordinate space
        const containerCenter = gallery.scrollLeft + gallery.clientWidth / 2;

        // Last card center evaluation
        const lastCard = cards[cards.length - 1];
        const lastCardCenter = lastCard.offsetLeft + lastCard.offsetWidth / 2;
        const maxScrollLeft = gallery.scrollWidth - gallery.clientWidth;

        // Rewind to beginning if last image is currently centered or at right edge
        if (Math.abs(containerCenter - lastCardCenter) < 16 || gallery.scrollLeft >= maxScrollLeft - 8) {
          gallery.scrollTo({ left: 0, behavior: 'smooth' });
          return;
        }

        // Geometric search: find first image whose center is geographically to the right of container center
        const targetCard = cards.find((card) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          return cardCenter > containerCenter + 8; // epsilon to avoid oscillating on current card
        });

        if (targetCard) {
          // Calculate scrollLeft offset required to perfectly align target card center with container center
          const targetCenter = targetCard.offsetLeft + targetCard.offsetWidth / 2;
          const calculatedOffset = Math.max(0, targetCenter - gallery.clientWidth / 2);
          gallery.scrollTo({ left: Math.round(calculatedOffset), behavior: 'smooth' });
        } else {
          // Fallback rewind to beginning if no further cards to the right
          gallery.scrollTo({ left: 0, behavior: 'smooth' });
        }
      };

      const startAutoAdvance = () => {
        if (intervalId !== null) return;
        intervalId = window.setInterval(executeSmartAutoCentering, 5000);
      };

      const stopAutoAdvance = () => {
        if (intervalId !== null) {
          clearInterval(intervalId);
          intervalId = null;
        }
      };

      const restartIdleTimer = (delay = 3000) => {
        if (idleTimer !== null) {
          clearTimeout(idleTimer);
          idleTimer = null;
        }
        idleTimer = window.setTimeout(() => {
          if (!isDown && !isHovered && !isTouchInteracting && rafId === null && Math.abs(velocity) <= 0.05) {
            startAutoAdvance();
          }
        }, delay);
      };

      // 2. Momentum Inertia Physics Loop
      const startInertia = () => {
        cancelInertia();
        gallery.style.scrollBehavior = 'auto';

        const step = () => {
          velocity *= 0.95; // 0.95 friction multiplier per frame
          gallery.scrollLeft -= velocity;

          if (Math.abs(velocity) > 0.1) {
            rafId = requestAnimationFrame(step);
          } else {
            // Absolute zero reached: cleanly reset physics state and resume smooth scroll
            velocity = 0;
            rafId = null;
            gallery.style.scrollBehavior = 'smooth';
            if (!isHovered && !isDown && !isTouchInteracting) {
              restartIdleTimer(3000);
            }
          }
        };

        rafId = requestAnimationFrame(step);
      };

      // 3. Mouse Click-and-Drag Controller
      const onMouseDown = (e: MouseEvent) => {
        if (isTouchInteracting || e.button !== 0) return;

        cancelInertia();
        velocity = 0;
        isDown = true;
        hasDragged = false;
        startX = e.pageX;
        lastX = e.pageX;
        lastTime = performance.now();

        // Visual grab state toggle
        gallery.classList.remove('cursor-grab');
        gallery.classList.add('cursor-grabbing');
        gallery.style.cursor = 'grabbing';
        gallery.style.scrollBehavior = 'auto';

        stopAutoAdvance();
        if (idleTimer !== null) {
          clearTimeout(idleTimer);
          idleTimer = null;
        }
      };

      const onMouseMove = (e: MouseEvent) => {
        if (!isDown) return;
        e.preventDefault();

        const now = performance.now();
        const dt = Math.max(1, now - lastTime);
        const delta = Math.abs(e.pageX - startX);
        if (delta > 4) {
          hasDragged = true;
        }

        const moveDelta = e.pageX - lastX;
        gallery.scrollLeft -= moveDelta;

        // Velocity tracking normalized to 60fps frame (~16.67ms)
        const instantVelocity = (moveDelta / dt) * 16.67;
        velocity = velocity * 0.3 + instantVelocity * 0.7;

        lastX = e.pageX;
        lastTime = now;
      };

      const onMouseUp = () => {
        if (!isDown) return;
        isDown = false;

        // Restore grab state
        gallery.classList.remove('cursor-grabbing');
        gallery.classList.add('cursor-grab');
        gallery.style.cursor = 'grab';

        // Discard velocity if user held mouse still prior to release
        const timeSinceLastMove = performance.now() - lastTime;
        if (timeSinceLastMove > 80) {
          velocity = 0;
        }

        // Trigger inertia loop or restore smooth scroll
        if (Math.abs(velocity) > 0.5) {
          startInertia();
        } else {
          velocity = 0;
          gallery.style.scrollBehavior = 'smooth';
          if (!isHovered) {
            restartIdleTimer(3000);
          }
        }
      };

      const onMouseLeave = () => {
        isHovered = false;
        if (isDown) {
          onMouseUp();
        } else if (rafId === null && Math.abs(velocity) <= 0.05) {
          restartIdleTimer(2000);
        }
      };

      const onMouseEnter = () => {
        isHovered = true;
        stopAutoAdvance();
        if (idleTimer !== null) {
          clearTimeout(idleTimer);
          idleTimer = null;
        }
      };

      // Prevent native ghost thumbnail detachment
      const onDragStart = (e: DragEvent) => {
        e.preventDefault();
      };

      // Native touch events passthrough: pause ticker on touch, resume on release
      const onTouchStart = () => {
        isTouchInteracting = true;
        cancelInertia();
        velocity = 0;
        if (touchResetTimeout !== null) {
          clearTimeout(touchResetTimeout);
          touchResetTimeout = null;
        }
        stopAutoAdvance();
        if (idleTimer !== null) {
          clearTimeout(idleTimer);
          idleTimer = null;
        }
      };

      const onTouchEnd = () => {
        touchResetTimeout = window.setTimeout(() => {
          isTouchInteracting = false;
        }, 500);
        restartIdleTimer(4000);
      };

      // 4. Mouse-wheel translation (converts vertical wheel delta to horizontal scroll)
      const onWheel = (evt: WheelEvent) => {
        cancelInertia();
        velocity = 0;
        stopAutoAdvance();
        restartIdleTimer(3500);

        if (evt.deltaY !== 0) {
          const maxScrollLeft = gallery.scrollWidth - gallery.clientWidth;
          const atStart = gallery.scrollLeft <= 0 && evt.deltaY < 0;
          const atEnd = gallery.scrollLeft >= maxScrollLeft - 2 && evt.deltaY > 0;

          if (!atStart && !atEnd) {
            evt.preventDefault();
            gallery.scrollLeft += evt.deltaY;
          }
        }
      };

      // Suppress unintentional click navigation if a drag gesture occurred
      const onClickCapture = (e: MouseEvent) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          hasDragged = false;
        }
      };

      // Attach event listeners
      gallery.addEventListener('mousedown', onMouseDown);
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
      window.addEventListener('blur', onMouseUp);
      gallery.addEventListener('mouseenter', onMouseEnter);
      gallery.addEventListener('mouseleave', onMouseLeave);
      gallery.addEventListener('dragstart', onDragStart);
      gallery.addEventListener('touchstart', onTouchStart, { passive: true });
      gallery.addEventListener('touchend', onTouchEnd, { passive: true });
      gallery.addEventListener('touchcancel', onTouchEnd, { passive: true });
      gallery.addEventListener('wheel', onWheel, { passive: false });
      gallery.addEventListener('click', onClickCapture, true);

      // Initialize auto-advance ticker
      startAutoAdvance();

      // Register cleanup handler for page transitions and unmount
      const instance: GalleryInstance = {
        destroy: () => {
          stopAutoAdvance();
          cancelInertia();
          if (idleTimer !== null) {
            clearTimeout(idleTimer);
            idleTimer = null;
          }
          if (touchResetTimeout !== null) {
            clearTimeout(touchResetTimeout);
            touchResetTimeout = null;
          }
          gallery.removeEventListener('mousedown', onMouseDown);
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
          window.removeEventListener('blur', onMouseUp);
          gallery.removeEventListener('mouseenter', onMouseEnter);
          gallery.removeEventListener('mouseleave', onMouseLeave);
          gallery.removeEventListener('dragstart', onDragStart);
          gallery.removeEventListener('touchstart', onTouchStart);
          gallery.removeEventListener('touchend', onTouchEnd);
          gallery.removeEventListener('touchcancel', onTouchEnd);
          gallery.removeEventListener('wheel', onWheel);
          gallery.removeEventListener('click', onClickCapture, true);
        },
      };

      activeGalleries.push(instance);
    });
  }

  setupDesktopHorizontalGallery();
  document.addEventListener('astro:page-load', setupDesktopHorizontalGallery);
  document.addEventListener('astro:before-swap', cleanupActiveGalleries);
  window.addEventListener('pagehide', cleanupActiveGalleries);
</script>

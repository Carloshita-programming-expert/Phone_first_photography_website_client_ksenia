---
import Layout from '../layouts/Layout.astro';
import { getCloudinaryUrl } from '../utils/cloudinary';
import { client } from '../../tina/__generated__/client';
import { Mail, Camera, MapPin, Film, Sparkles } from 'lucide-astro';
import { useTranslations } from '../i18n/ui';

const currentLang = (Astro.url.searchParams.get('lang') as 'en' | 'ru') || 'en';

const t = useTranslations(currentLang);
const tEn = useTranslations('en');
const tRu = useTranslations('ru');

const defaultProfile = {
  name: 'Ksenia',
  bio_en:
    'Visual artist and analog photographer based in Berlin. Exploring brutalist geometry, nocturnal streetscapes, and solitary geological landscapes across Europe and Central Asia using 35mm and medium format systems.',
  bio_ru:
    'Визуальный художник и пленочный фотограф из Берлина. Исследует архитектурный брутализм, ночные городские пейзажи и уединенные геологические ландшафты Европы и Центральной Азии на 35-миллиметровую и среднеформатную пленку.',
  email: 'ksenia@visualstories.photography',
  portrait: 'samples/people/smiling-man',
};

let profileData: any = null;
try {
  if (typeof client.queries.global_profile === 'function') {
    const profileResponse = await client.queries.global_profile({
      relativePath: 'ksenia.json',
    });
    profileData = profileResponse?.data?.global_profile;
  } else if (typeof client.queries.global_profileConnection === 'function') {
    const profileRes = await client.queries.global_profileConnection();
    profileData = profileRes?.data?.global_profileConnection?.edges?.[0]?.node;
  } else if (typeof (client.queries as any).profile === 'function') {
    const profileResponse = await (client.queries as any).profile({
      relativePath: 'ksenia.json',
    });
    profileData = profileResponse?.data?.profile;
  } else if (typeof (client.queries as any).profileConnection === 'function') {
    const profileRes = await (client.queries as any).profileConnection();
    profileData = profileRes?.data?.profileConnection?.edges?.[0]?.node;
  }
} catch (_err) {
  // Gracefully fallback to defaultProfile during static build
}

const profile = profileData || defaultProfile;

const name = profile?.name || defaultProfile.name;
const bioEn = profile?.bio_en || defaultProfile.bio_en;
const bioRu = profile?.bio_ru || defaultProfile.bio_ru;
const email = profile?.email || defaultProfile.email;
const profileImage =
  profile?.portrait ||
  profile?.profile_image ||
  defaultProfile.portrait;
---

<Layout
  title={t('profile.title')}
  description={t('profile.description')}
  currentLang={currentLang}
  activeTab="about"
>
  <div class="w-full max-w-xl mx-auto px-4 py-8 sm:py-12 flex flex-col items-center text-center">
    <!-- Centered Editorial Profile Portrait -->
    <div class="relative group mb-6">
      <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-luxury-taupe via-luxury-crimson to-luxury-taupe opacity-60 blur-sm group-hover:opacity-100 transition duration-500"></div>
      <div class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-full overflow-hidden border-2 border-luxury-taupe/40 shadow-2xl bg-luxury-base">
        <img
          src={getCloudinaryUrl(profileImage, 'f_auto,q_auto')}
          alt={`${name} portrait`}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        />
      </div>
      <div
        class="absolute bottom-1 right-2 w-6 h-6 rounded-full bg-luxury-crimson border-2 border-luxury-base flex items-center justify-center shadow-lg"
        title={currentLang === 'ru' ? tRu('profile.availableBadge') : tEn('profile.availableBadge')}
      >
        <Sparkles class="w-3 h-3 text-luxury-cream stroke-[2.5]" />
      </div>
    </div>

    <!-- Name & Editorial Byline -->
    <h1 class="font-serif text-3xl sm:text-4xl text-luxury-cream font-normal tracking-tight">
      <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('hero.name')}</span>
      <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('hero.name')}</span>
    </h1>
    <div class="flex items-center gap-2 mt-2 text-xs font-mono uppercase tracking-widest text-luxury-taupe">
      <span class="flex items-center gap-1">
        <MapPin class="w-3 h-3 text-luxury-taupe" />
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.location')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.location')}</span>
      </span>
      <span>•</span>
      <span class="flex items-center gap-1">
        <Camera class="w-3 h-3 text-luxury-taupe" />
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.discipline')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.discipline')}</span>
      </span>
    </div>

    <!-- Editorial Divider -->
    <div class="w-12 h-[1px] bg-luxury-taupe/30 my-6"></div>

    <!-- Bilingual Bio Text Blocks -->
    <div class="w-full space-y-4 text-sm sm:text-base leading-relaxed text-luxury-cream/90 font-light text-left sm:text-center px-2">
      <!-- English Bio Block -->
      <p class="bio-text-en transition-opacity duration-200" data-bio-lang="en">
        {bioEn}
      </p>

      <!-- Russian Bio Block -->
      <p class="bio-text-ru text-luxury-cream/80 italic text-sm transition-opacity duration-200" data-bio-lang="ru">
        {bioRu}
      </p>
    </div>

    <!-- Apparatus & Philosophy Sub-card -->
    <div class="w-full grid grid-cols-2 gap-3 mt-8 text-left">
      <div class="p-3.5 rounded-lg bg-luxury-base/80 border border-luxury-taupe/30 flex flex-col justify-between">
        <div class="flex items-center gap-1.5 text-luxury-taupe text-xs font-mono uppercase tracking-wider">
          <Film class="w-3.5 h-3.5 text-luxury-taupe" />
          <span>
            <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.mediaHeading')}</span>
            <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.mediaHeading')}</span>
          </span>
        </div>
        <p class="text-xs text-luxury-cream font-medium mt-1">
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.mediaList')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.mediaList')}</span>
        </p>
      </div>

      <div class="p-3.5 rounded-lg bg-luxury-base/80 border border-luxury-taupe/30 flex flex-col justify-between">
        <div class="flex items-center gap-1.5 text-luxury-taupe text-xs font-mono uppercase tracking-wider">
          <Camera class="w-3.5 h-3.5 text-luxury-taupe" />
          <span>
            <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.apparatusHeading')}</span>
            <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.apparatusHeading')}</span>
          </span>
        </div>
        <p class="text-xs text-luxury-cream font-medium mt-1">
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.apparatusList')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.apparatusList')}</span>
        </p>
      </div>
    </div>

    <!-- Clean Editorial Contact Button -->
    <div class="mt-10">
      <a
        href={`mailto:${email}?subject=Commission%20%2F%20Print%20Inquiry`}
        class="inline-flex items-center gap-2.5 px-7 py-3 rounded-full bg-luxury-cream text-luxury-base border border-luxury-taupe font-semibold text-xs uppercase tracking-widest hover:bg-luxury-crimson hover:text-luxury-cream hover:border-luxury-crimson hover:scale-105 active:scale-95 transition-all shadow-[0_0_25px_rgba(113,28,29,0.25)]"
      >
        <Mail class="w-4 h-4 stroke-[2]" />
        <span>
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('profile.contactBtn')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('profile.contactBtn')}</span>
        </span>
      </a>
      <div class="mt-3 text-[11px] font-mono text-luxury-taupe">
        {email}
      </div>
    </div>
  </div>
</Layout>

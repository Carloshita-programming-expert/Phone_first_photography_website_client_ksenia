---
import Layout from '../layouts/Layout.astro';
import MasonryGrid from '../components/MasonryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { client } from '../../tina/__generated__/client';
import { useTranslations } from '../i18n/ui';

const currentLang = (Astro.url.searchParams.get('lang') as 'en' | 'ru') || 'en';

const t = useTranslations(currentLang);
const tEn = useTranslations('en');
const tRu = useTranslations('ru');

let posts: any[] = [];
try {
  if (typeof client.queries.photoshootsConnection === 'function') {
    const response = await client.queries.photoshootsConnection();
    posts = response?.data?.photoshootsConnection?.edges?.map((edge: any) => edge?.node).filter(Boolean) || [];
  }
} catch (_err) {
  // Graceful fallback during build
}
---

<Layout
  title={t('collage.title')}
  description={t('collage.description')}
  currentLang={currentLang}
  activeTab="grid"
>
  <div class="w-full px-3 py-4 sm:px-6">
    <header class="mb-6 text-center">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-luxury-taupe">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('collage.tag')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('collage.tag')}</span>
      </span>
      <h1 class="font-serif text-2xl sm:text-3xl text-luxury-cream tracking-tight font-medium mt-1">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('collage.heading')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('collage.heading')}</span>
      </h1>
      <p class="text-xs text-luxury-taupe max-w-md mx-auto mt-2 leading-relaxed">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('collage.desc')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('collage.desc')}</span>
      </p>
    </header>

    <MasonryGrid posts={posts} />
    <Lightbox currentLang={currentLang} />
  </div>
</Layout>

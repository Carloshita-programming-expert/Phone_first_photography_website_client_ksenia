---
import Layout from '../layouts/Layout.astro';
import MasonryGrid from '../components/MasonryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { client } from '../../tina/__generated__/client';
import { useTranslations } from '../i18n/ui';

const currentLang = (Astro.url.searchParams.get('lang') as 'en' | 'ru') || 'en';

const t = useTranslations(currentLang);
const tEn = useTranslations('en');
const tRu = useTranslations('ru');

let posts: any[] = [];
try {
  if (typeof client.queries.photoshootsConnection === 'function') {
    const response = await client.queries.photoshootsConnection();
    posts = response?.data?.photoshootsConnection?.edges?.map((edge: any) => edge?.node).filter(Boolean) || [];
  }
} catch (_err) {
  // Graceful fallback during build
}

// Resilient fallback: ensure all photoshoots render by default if GraphQL query returns empty
if (!posts || posts.length === 0) {
  try {
    const photoshootModules = import.meta.glob('../../content/photoshoots/*.json', { eager: true });
    posts = Object.entries(photoshootModules).map(([filePath, mod]: [string, any]) => {
      const data = mod?.default || mod;
      const filename = filePath.split('/').pop()?.replace('.json', '') || 'post';
      return {
        id: data.id || filename,
        ...data,
        _sys: { filename },
      };
    });
  } catch (_fallbackErr) {
    // Keep empty if unavailable
  }
}

// Sanitize and ensure safe category fallback defaults for every photoshoot item
const sanitizedPosts = posts.map((post: any) => ({
  ...post,
  id: post?.id || post?._sys?.filename || 'shoot',
  title: post?.title || 'Untitled Series',
  title_ru: post?.title_ru || post?.title || 'Безымянная серия',
  category: (post?.category && typeof post.category === 'string' && post.category.trim() !== '') ? post.category : 'Uncategorized',
  location: post?.location || 'Unknown Location',
  camera: post?.camera || '35mm Film',
  date: post?.date || '',
  images: (Array.isArray(post?.images) ? post.images : []).filter(Boolean) as string[],
  caption_en: post?.caption_en || '',
  caption_ru: post?.caption_ru || '',
}));

const filterCategories = [
  { key: 'all', labelEn: tEn('category.all'), labelRu: tRu('category.all') },
  { key: 'Portraiture', labelEn: tEn('category.portraiture'), labelRu: tRu('category.portraiture') },
  { key: 'Editorial', labelEn: tEn('category.editorial'), labelRu: tRu('category.editorial') },
  { key: 'Love Story', labelEn: tEn('category.loveStory'), labelRu: tRu('category.loveStory') },
  { key: 'Documentary', labelEn: tEn('category.documentary'), labelRu: tRu('category.documentary') },
];
---

<Layout
  title={t('collage.title')}
  description={t('collage.description')}
  currentLang={currentLang}
  activeTab="grid"
>
  <div class="w-full px-3 py-4 sm:px-6">
    <header class="mb-6 text-center">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-luxury-taupe">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('collage.tag')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('collage.tag')}</span>
      </span>
      <h1 class="font-serif text-2xl sm:text-3xl text-luxury-cream tracking-tight font-medium mt-1">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('collage.heading')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('collage.heading')}</span>
      </h1>
      <p class="text-xs text-luxury-taupe max-w-md mx-auto mt-2 leading-relaxed">
        <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('collage.desc')}</span>
        <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('collage.desc')}</span>
      </p>

      <!-- Category Filter Pills Bar -->
      <div class="flex items-center justify-center flex-wrap gap-2 mt-5" role="group" aria-label="Category Filter">
        {filterCategories.map((cat) => (
          <button
            type="button"
            data-filter-category={cat.key}
            class="category-filter-btn px-3.5 py-1 rounded-full text-xs font-mono uppercase tracking-wider border border-luxury-taupe/30 text-luxury-taupe hover:text-luxury-cream hover:border-luxury-taupe transition-all duration-200 cursor-pointer"
          >
            <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{cat.labelEn}</span>
            <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{cat.labelRu}</span>
          </button>
        ))}
      </div>
    </header>

    <MasonryGrid posts={sanitizedPosts} />
    <Lightbox currentLang={currentLang} />
  </div>

  <script>
    function setupCollageCategoryFilter() {
      const url = new URL(window.location.href);
      // Strictly check if ?category= parameter is present and non-empty
      const rawCategoryParam = url.searchParams.get('category');
      const hasCategoryParam = rawCategoryParam !== null && rawCategoryParam.trim() !== '';

      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter-category]');
      const cards = document.querySelectorAll<HTMLElement>('[data-masonry-card]');

      function applyFilter(categoryFilter: string | null, updateUrl: boolean = false) {
        // Strict category filtering ONLY applies when categoryFilter is provided, non-empty, and not 'all'
        const isStrictFilterActive = Boolean(categoryFilter && categoryFilter.toLowerCase() !== 'all');
        const activeFilterKey = isStrictFilterActive ? categoryFilter!.toLowerCase() : 'all';

        // Update button active styling
        buttons.forEach((btn) => {
          const btnCat = (btn.getAttribute('data-filter-category') || '').toLowerCase();
          const isActive = btnCat === activeFilterKey;
          if (isActive) {
            btn.classList.add('bg-luxury-crimson', 'text-luxury-cream', 'border-luxury-crimson', 'font-semibold', 'shadow-sm');
            btn.classList.remove('text-luxury-taupe', 'hover:text-luxury-cream', 'border-luxury-taupe/30');
          } else {
            btn.classList.remove('bg-luxury-crimson', 'text-luxury-cream', 'border-luxury-crimson', 'font-semibold', 'shadow-sm');
            btn.classList.add('text-luxury-taupe', 'hover:text-luxury-cream', 'border-luxury-taupe/30');
          }
        });

        // Filter masonry cards:
        // When strict filter is NOT active, strictly render ALL cards by default (including 'Uncategorized')
        cards.forEach((card) => {
          if (!isStrictFilterActive) {
            // Render all photoshoots by default without dropping anything
            card.classList.remove('hidden');
          } else {
            // Strict category filtering
            const cardCat = (card.getAttribute('data-category') || 'uncategorized').toLowerCase();
            if (cardCat === activeFilterKey) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }
        });

        // Update URL query parameter only upon user interactive button click
        if (updateUrl) {
          const nextUrl = new URL(window.location.href);
          if (isStrictFilterActive) {
            nextUrl.searchParams.set('category', categoryFilter!);
          } else {
            nextUrl.searchParams.delete('category');
          }
          window.history.replaceState({}, '', nextUrl.toString());
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-filter-category');
          applyFilter(cat, true);
        });
      });

      // Strict category filtering ONLY applies when the URL parameter ?category= is actively present
      if (hasCategoryParam) {
        applyFilter(rawCategoryParam, false);
      } else {
        applyFilter('all', false);
      }
    }

    setupCollageCategoryFilter();
    document.addEventListener('astro:page-load', setupCollageCategoryFilter);
  </script>
</Layout>

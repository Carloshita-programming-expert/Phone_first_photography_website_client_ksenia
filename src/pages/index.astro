---
import Layout from '../layouts/Layout.astro';
import FeedPost from '../components/FeedPost.astro';

const mockPost = {
  id: 'editorial-01',
  title: 'Nocturnal Reverie',
  location: 'Kyoto, Japan',
  images: [
    'samples/landscapes/nature-mountains',
    'samples/landscapes/beach-boat',
    'samples/animals/kitten-playing'
  ],
  captions: {
    en: 'Shadows folding over the traditional machiya alleys at twilight. Shot on CineStill 800T.',

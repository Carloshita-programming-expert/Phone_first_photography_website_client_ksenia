---
import Layout from '../layouts/Layout.astro';
import HeroProfile from '../components/HeroProfile.astro';
import FeedPost from '../components/FeedPost.astro';
import DesktopHorizontalGallery from '../components/DesktopHorizontalGallery.astro';
import { client } from '../../tina/__generated__/client';
import { useTranslations } from '../i18n/ui';

const currentLang = (Astro.url.searchParams.get('lang') as 'en' | 'ru') || 'en';

const t = useTranslations(currentLang);
const tEn = useTranslations('en');
const tRu = useTranslations('ru');

let posts: any[] = [];
try {
  if (typeof client.queries.photoshootsConnection === 'function') {
    const response = await client.queries.photoshootsConnection();
    posts = response?.data?.photoshootsConnection?.edges?.map((edge: any) => edge?.node).filter(Boolean) || [];
  }
} catch (_err) {
  // Graceful fallback during build
}

// Resilient fallback: ensure all photoshoots render by default if GraphQL query returns empty
if (!posts || posts.length === 0) {
  try {
    const photoshootModules = import.meta.glob('../../content/photoshoots/*.json', { eager: true });
    posts = Object.entries(photoshootModules).map(([filePath, mod]: [string, any]) => {
      const data = mod?.default || mod;
      const filename = filePath.split('/').pop()?.replace('.json', '') || 'post';
      return {
        id: data.id || filename,
        ...data,
        _sys: { filename },
      };
    });
  } catch (_fallbackErr) {
    // Keep empty if unavailable
  }
}

// Sanitize and ensure safe category fallback defaults for every photoshoot item
const sanitizedPosts = posts.map((post: any) => ({
  ...post,
  id: post?.id || post?._sys?.filename || 'photoshoot',
  title: post?.title || 'Untitled',
  title_ru: post?.title_ru || post?.title || 'Без названия',
  category: (post?.category && typeof post.category === 'string' && post.category.trim() !== '') ? post.category : 'Uncategorized',
  location: post?.location || 'Unknown Location',
  camera: post?.camera || '35mm Film',
  date: post?.date || 'Recent Series',
  images: (Array.isArray(post?.images) ? post.images : []).filter(Boolean) as string[],
  caption_en: post?.caption_en || '',
  caption_ru: post?.caption_ru || '',
}));
---

<Layout
  title={t('layout.title')}
  description={t('layout.description')}
  currentLang={currentLang}
  activeTab="home"
  snapDesktop={true}
>
  <!-- Landing View: Profile-First Experience (min-h-screen initial viewport) -->
  <HeroProfile currentLang={currentLang} />

  <!-- Photography Works Section below the Hero Profile -->
  <div id="photography-section" class="w-full pt-8 sm:pt-12 border-t border-luxury-taupe/20">
    <!-- Mobile Viewport: Instagram-style vertical scroll-snap feed (block lg:hidden) -->
    <section class="block lg:hidden w-full flex flex-col" aria-label="Mobile Photography Feed">
      {sanitizedPosts.map((post, index) => (
        <FeedPost
          id={post.id}
          title={post.title}
          title_ru={post.title_ru}
          category={post.category}
          location={post.location}
          camera={post.camera}
          date={post.date}
          images={post.images}
          captions={{
            en: post.caption_en,
            ru: post.caption_ru,
          }}
          isFirstPost={index === 0}
        />
      ))}
    </section>

    <!-- Desktop Viewport: Horizontal Scroll Filmstrip Gallery (hidden lg:flex) -->
    <section
      class="hidden lg:flex w-full min-h-[100dvh] flex-col justify-center snap-center lg:snap-center"
      style="scroll-snap-align: center;"
      aria-label="Desktop Filmstrip Gallery"
    >
      <div class="mb-6 flex flex-col items-center text-center px-4">
        <span class="text-xs font-mono uppercase tracking-[0.3em] text-luxury-taupe">
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.tag')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.tag')}</span>
        </span>
        <h2 class="font-serif text-3xl xl:text-4xl text-luxury-cream tracking-tight font-normal mt-2">
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.heading')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.heading')}</span>
        </h2>
        <p class="text-sm text-luxury-taupe max-w-lg mx-auto mt-2 font-light leading-relaxed">
          <span data-i18n-lang="en" class={currentLang === 'ru' ? 'hidden' : ''}>{tEn('filmstrip.desc')}</span>
          <span data-i18n-lang="ru" class={currentLang === 'en' ? 'hidden' : ''}>{tRu('filmstrip.desc')}</span>
        </p>
      </div>

      <DesktopHorizontalGallery posts={sanitizedPosts} currentLang={currentLang} />
    </section>
  </div>
</Layout>

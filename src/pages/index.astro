---
import Layout from '../layouts/Layout.astro';
import HeroProfile from '../components/HeroProfile.astro';
import FeedPost from '../components/FeedPost.astro';
import DesktopHorizontalGallery from '../components/DesktopHorizontalGallery.astro';
import { client } from '../../tina/__generated__/client';

const currentLang = (Astro.url.searchParams.get('lang') as 'en' | 'ru') || 'en';

let posts: any[] = [];
try {
  if (typeof client.queries.photoshootsConnection === 'function') {
    const response = await client.queries.photoshootsConnection();
    posts = response?.data?.photoshootsConnection?.edges?.map((edge: any) => edge?.node).filter(Boolean) || [];
  }
} catch (_err) {
  // Graceful fallback during build
}
---

<Layout
  title="Visual Stories | Photography Portfolio"
  description="Curated high-end photography portfolio featuring stories from Kyoto, Iceland, Berlin, Almaty, and Milos."
  currentLang={currentLang}
  activeTab="home"
  snapDesktop={true}
>
  <!-- Landing View: Profile-First Experience (min-h-screen initial viewport) -->
  <HeroProfile currentLang={currentLang} />

  <!-- Photography Works Section below the Hero Profile -->
  <div id="photography-section" class="w-full pt-8 sm:pt-12 border-t border-luxury-taupe/20 lg:snap-start">
    <!-- Mobile Viewport: Instagram-style vertical scroll-snap feed (block lg:hidden) -->
    <section class="block lg:hidden w-full flex flex-col" aria-label="Mobile Photography Feed">
      {posts.map((post, index) => (
        <FeedPost
          id={post.id || post._sys?.filename}
          title={post.title}
          title_ru={post.title_ru}
          location={post.location}
          camera={post.camera || '35mm Film'}
          date={post.date || 'Recent Series'}
          images={(post.images || []).filter(Boolean) as string[]}
          captions={{
            en: post.caption_en || '',
            ru: post.caption_ru || '',
          }}
          isFirstPost={index === 0}
        />
      ))}
    </section>

    <!-- Desktop Viewport: Horizontal Scroll Filmstrip Gallery (hidden lg:block) -->
    <section class="hidden lg:block w-full" aria-label="Desktop Filmstrip Gallery">
      <div class="mb-6 flex flex-col items-center text-center px-4">
        <span class="text-xs font-mono uppercase tracking-[0.3em] text-luxury-taupe">
          Curated Photographic Works
        </span>
        <h2 class="font-serif text-3xl xl:text-4xl text-luxury-cream tracking-tight font-normal mt-2">
          The Filmstrip Archives
        </h2>
        <p class="text-sm text-luxury-taupe max-w-lg mx-auto mt-2 font-light leading-relaxed">
          High-resolution 35mm and medium format captures arranged as an expansive contact sheet. Scroll horizontally using your mouse wheel.
        </p>
      </div>

      <DesktopHorizontalGallery posts={posts} currentLang={currentLang} />
    </section>
  </div>
</Layout>

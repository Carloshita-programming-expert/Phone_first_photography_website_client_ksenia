---
import Layout from '../layouts/Layout.astro';
import FeedPost from '../components/FeedPost.astro';
import feedData from '../data/feed.json';

const currentLang = (Astro.url.searchParams.get('lang') as 'en' | 'ru') || 'en';
---

<Layout
  title="Visual Stories | Mobile Photography Portfolio"
  description="Curated high-end photography portfolio featuring stories from Kyoto, Iceland, Berlin, Almaty, and Milos."
  currentLang={currentLang}
>
  <section class="w-full flex flex-col" aria-label="Photography Feed">
    {feedData.map((post, index) => (
      <FeedPost
        id={post.id}
        title={post.title}
        location={post.location}
        camera={post.camera}
        date={post.date}
        images={post.images}
        captions={post.captions}
        isFirstPost={index === 0}
      />
    ))}
  </section>
</Layout>
